<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>Eigenframe</string>
    <key>CFBundleIdentifier</key>
    <string>com.eigenframe.app</string>
    <key>CFBundleName</key>
    <string>Eigenframe</string>
    <key>CFBundleDisplayName</key>
    <string>Eigenframe</string>
    <key>CFBundleVersion</key>
    <string>8</string>
    <key>CFBundleShortVersionString</key>
    <string>1.5.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- Input Monitoring is the only privacy permission Eigenframe asks for, and
         only when pause-while-typing is switched on. NSAccessibilityUsageDescription
         was declared here previously but the app never calls any Accessibility API;
         advertising it invited users to grant a far broader permission (which
         allows synthesising and rewriting events, not just observing them) than
         anything the app can use. -->
    <key>NSInputMonitoringUsageDescription</key>
    <string>Eigenframe watches for keystrokes only to pause video wallpapers while you type. Keystrokes are never recorded, stored, or sent anywhere.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
